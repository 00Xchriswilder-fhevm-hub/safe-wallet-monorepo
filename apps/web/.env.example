NEXT_PUBLIC_INFURA_TOKEN=1234567890
NEXT_PUBLIC_WC_PROJECT_ID=0987654321
NEXT_PUBLIC_IS_OFFICIAL_HOST=false
NEXT_PUBLIC_PROD_MIXPANEL_TOKEN=1234567890 # Use Mixpanel Project TEST here
NEXT_PUBLIC_STAGING_MIXPANEL_TOKEN=1234567890 # Use Mixpanel Project TEST here, too

# ---- Confidential / FHE (Sepolia) — relayer REST + Zama multisig flow ----
